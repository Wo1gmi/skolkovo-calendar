FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt \
    && useradd --uid 10001 --create-home bot \
    && mkdir /state && chown bot:bot /state
COPY daily_schedule_bot.py notifications.py schedule_rules.py sync.py subject_colors.json ./
USER bot
CMD ["python", "daily_schedule_bot.py", "--state", "/state/telegram-bot.sqlite3"]
